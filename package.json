{
  "name": "avalon",
  "version": "0.1.0",
  "description": "Avalon 本地小说工作台",
  "private": true,
  "type": "module",
  "main": "out/main/index.cjs",
  "packageManager": "npm@11.16.0",
  "engines": {
    "node": ">=24.0.0 <25",
    "npm": ">=11.0.0 <12"
  },
  "scripts": {
    "dev": "electron-vite dev --watch",
    "build": "electron-vite build",
    "pack:win": "npm run build && electron-builder --config electron-builder.config.cjs --win --x64 --dir --publish never",
    "dist:win": "npm run build && electron-builder --config electron-builder.config.cjs --win nsis --x64 --publish never",
    "package": "npm run dist:win",
    "preview": "electron-vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "test:unit": "vitest run",
    "test:e2e": "node scripts/run-e2e.mjs"
  },
  "dependencies": {
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@playwright/test": "1.65.0",
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "6.2.1",
    "electron": "45.2.3",
    "electron-builder": "26.18.0",
    "electron-vite": "6.0.0",
    "typescript": "7.0.2",
    "vite": "8.3.6",
    "vitest": "5.1.0"
  }
}
